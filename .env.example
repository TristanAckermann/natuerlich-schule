# A generated secret for Payload
PAYLOAD_SECRET=

# Öffentliche Basis-URL der Website, ohne abschliessenden Schrägstrich
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Gemeinsames Geheimnis für den Draft-Preview-Handshake (/next/preview)
PREVIEW_SECRET=

# SQLite-Datenbank als libsql-URL. Lokal weglassen — dann wird payload.db im
# Projektstamm verwendet. Auf dem Hosting auf einen Pfad ausserhalb des
# Deployment-Ordners zeigen, sonst ist die Datenbank nach dem nächsten
# Deployment weg:
#   DATABASE_URI=file:/home/clients/<konto>/data/payload.db
DATABASE_URI=

# Ablage der hochgeladenen Bilder und Videos. Lokal weglassen — dann ./media.
# Auf dem Hosting ebenfalls ausserhalb des Deployment-Ordners:
#   MEDIA_DIR=/home/clients/<konto>/data/media
MEDIA_DIR=
